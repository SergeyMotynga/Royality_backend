ROYALITY_APP_TITLE=Royality Backend
ROYALITY_ENV=local
ROYALITY_LOG_LEVEL=INFO
ROYALITY_SECRET_KEY=CHANGE_ME_SECRET_KEY

# Локальный запуск backend (вне Docker).
ROYALITY_APP_HOST=localhost
ROYALITY_APP_PORT=8000
ROYALITY_POSTGRES_USER=CHANGE_ME_POSTGRES_USER
ROYALITY_POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
ROYALITY_POSTGRES_DB=CHANGE_ME_POSTGRES_DB
ROYALITY_POSTGRES_HOST=localhost
ROYALITY_POSTGRES_PORT=5432
ROYALITY_DATABASE_URL=postgresql+psycopg://CHANGE_ME_POSTGRES_USER:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/CHANGE_ME_POSTGRES_DB
ROYALITY_MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
ROYALITY_MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
ROYALITY_MINIO_ENDPOINT=localhost:9000
ROYALITY_MINIO_PUBLIC_ENDPOINT=localhost:9000
ROYALITY_MINIO_API_PORT=9000
ROYALITY_MINIO_CONSOLE_PORT=9001
ROYALITY_MINIO_BUCKET_NAME=CHANGE_ME_MINIO_BUCKET_NAME
ROYALITY_MINIO_REGION=us-east-1
ROYALITY_MINIO_SECURE=false

# Запуск backend внутри Docker.
ROYALITY_DOCKER_APP_HOST=0.0.0.0
ROYALITY_DOCKER_APP_PORT=8000
ROYALITY_DOCKER_POSTGRES_HOST=postgres
ROYALITY_DOCKER_POSTGRES_PORT=5432
ROYALITY_DOCKER_DATABASE_URL=postgresql+psycopg://CHANGE_ME_POSTGRES_USER:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/CHANGE_ME_POSTGRES_DB
ROYALITY_DOCKER_MINIO_ENDPOINT=minio:9000
ROYALITY_DOCKER_MINIO_PUBLIC_ENDPOINT=localhost:9000
ROYALITY_DOCKER_MINIO_SECURE=false

# Firebase Cloud Messaging.
# Для локального запуска без пушей оставить false.
ROYALITY_FCM_ENABLED=false
ROYALITY_FIREBASE_CREDENTIALS_PATH=
ROYALITY_FIREBASE_CREDENTIALS_JSON=
