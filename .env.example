APP_TITLE=FinGuru Backend
ENV=local
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_LOCAL
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=26
REGISTER_RATE_LIMIT_MAX_REQUESTS_PER_EMAIL=5
REGISTER_RATE_LIMIT_MAX_REQUESTS_PER_IP=30
REGISTER_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_REQUESTS_PER_EMAIL=10
LOGIN_RATE_LIMIT_MAX_REQUESTS_PER_IP=60
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
VERIFY_RATE_LIMIT_MAX_REQUESTS_PER_EMAIL=5
VERIFY_RATE_LIMIT_MAX_REQUESTS_PER_IP=30
VERIFY_RATE_LIMIT_WINDOW_SECONDS=600
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@finguru.local
SMTP_FROM_NAME=FinGuru
SMTP_USE_TLS=false
SMTP_USE_SSL=false

POSTGRES_USER=finguru
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=finguru
DATABASE_URL=postgresql+psycopg://finguru:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/finguru
REDIS_URL=redis://localhost:6379/0

# Опционально: включайте только если используется OCR/загрузка файлов (MinIO/S3).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET_MEDIA=finguru-media
S3_BUCKET_AVATARS=finguru-avatars
S3_USE_SSL=false
S3_PRESIGN_EXPIRES_SECONDS=900

# Опционально: включайте только если используются async-воркеры/outbox (RabbitMQ/Celery).
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_DEFAULT_QUEUE=default
CELERY_RETRY_BACKOFF=true

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
