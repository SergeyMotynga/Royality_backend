APP_TITLE=Royality Backend
ENV=local
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_LOCAL
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_USER=royality
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=royality
DATABASE_URL=postgresql+psycopg://royality:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/royality
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET_MEDIA=royality-media
S3_BUCKET_AVATARS=royality-avatars
S3_USE_SSL=false
S3_PRESIGN_EXPIRES_SECONDS=900

RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_DEFAULT_QUEUE=default
CELERY_RETRY_BACKOFF=true

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
