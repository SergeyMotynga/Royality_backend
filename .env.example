APP_TITLE=Royality Backend
ENV=local
LOG_LEVEL=INFO

APP_HOST=localhost
APP_PORT=8000

POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=CHANGE_ME_POSTGRES_DB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://CHANGE_ME_POSTGRES_USER:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/CHANGE_ME_POSTGRES_DB

MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=CHANGE_ME_MINIO_BUCKET_NAME
MINIO_REGION=us-east-1
MINIO_SECURE=false

DOCKER_APP_HOST=0.0.0.0
DOCKER_APP_PORT=8000
DOCKER_POSTGRES_HOST=postgres
DOCKER_POSTGRES_PORT=5432
DOCKER_DATABASE_URL=postgresql+psycopg://CHANGE_ME_POSTGRES_USER:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/CHANGE_ME_POSTGRES_DB
DOCKER_MINIO_ENDPOINT=minio:9000
DOCKER_MINIO_SECURE=false
